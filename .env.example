# Salin ke .env.local untuk development. Jangan isi secret di file ini.
# Nilai production dan preview diatur di Vercel, secret CI di repository secret GitHub.

# URL publik website, tanpa garis miring di akhir. Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (opsional). Tanpa DSN, Sentry tidak mengirim apa pun.
NEXT_PUBLIC_SENTRY_DSN=
# Untuk upload source map saat build. Hanya di CI dan Vercel.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Halaman /dev/ui untuk review komponen. Otomatis aktif di development.
# Di CI (E2E production build) diisi 1. Jangan diisi di Vercel.
ENABLE_DEV_UI=

bash scripts/check-accounts.sh --quick || exit 1

# Tanpa branch protection (GitHub Free), push langsung ke main ditolak di sini.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "GAGAL push langsung ke ${remote_ref#refs/heads/} tidak diizinkan. Buka PR, lalu merge dengan scripts/merge-pr.sh."
      exit 1
      ;;
  esac
done
exit 0

  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && next dev",
    "build": "node scripts/copy-mediapipe.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "db:types": "echo \"db:types aktif di Fase 2\"",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify:full": "pnpm typecheck && pnpm lint && pnpm check:copy && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "prepare": "husky"
  },

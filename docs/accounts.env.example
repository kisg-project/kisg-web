# Salin ke ~/.config/kis/accounts.env lalu jalankan: chmod 600 ~/.config/kis/accounts.env
# File asli berisi token. Jangan pernah di-commit dan jangan disimpan di folder proyek.
# Dimuat otomatis oleh .claude/hooks/kis-accounts.sh setiap sesi Claude Code di proyek KIS.

# GitHub: pilih salah satu
# 1) GH_USER = akun gh KIS yang sudah login lewat `gh auth login` (token diambil otomatis), atau
# 2) GH_TOKEN = fine-grained personal access token khusus repo KIS
GH_USER=
GH_TOKEN=

# Identitas commit
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Kalau push lewat SSH dengan key khusus KIS (kosongkan kalau pakai HTTPS + GH_TOKEN)
# Contoh: ssh -i ~/.ssh/id_ed25519_kis -o IdentitiesOnly=yes
GIT_SSH_COMMAND=

# Supabase CLI (Account > Access Tokens di akun Supabase KIS)
SUPABASE_ACCESS_TOKEN=

# Vercel CLI (Account Settings > Tokens di akun Vercel KIS)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Sentry CLI (upload source map)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare (DNS, Email Routing, Turnstile). Token dibatasi ke zone kisgroup.co.id.
CLOUDFLARE_API_TOKEN=

# Brevo (email). SMTP untuk Supabase Auth, API untuk email aplikasi.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=
